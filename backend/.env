MONGO_URI=mongodb://localhost:27017
FAST_TO_SMS_API_KEY=BZTLtx1CkUyREw9YoANvdDigM4j5s8WmczfahlF7nebQPrXuG3CHqFbJGgAKiLkpVh1wXdjutPY7W6SQ

# ============================================================
# OTP MODE
# ============================================================
# "development" = Bypass Fast2SMS completely. No real SMS sent.
#                 Backend returns a mock OTP in the response.
# "production"  = Actually call Fast2SMS API and send REAL SMS.
#                 OTP is ONLY stored for verification; never returned.
# ============================================================
OTP_MODE=production

# ============================================================
# SMS / FAST2SMS CONFIGURATION (Required for OTP_MODE=production)
# ============================================================

# SMS Provider: Currently only "fast2sms" is supported
SMS_PROVIDER=fast2sms

# Sender ID: 6-character alphanumeric approved sender ID.
# Fast2SMS default/testing: FSTSMS
# For production, use your DLT-registered Sender ID (e.g., CUTOFF, FOURIS, etc.)
SMS_SENDER_ID=FSTSMS

# SMS Route (Fast2SMS route code)
#
#   "q"   = Quick / Transactional route  (DEFAULT, LOWEST CONFIG OVERHEAD)
#           - Sends free-form `message` text
#           - NO template_id required
#           - Works immediately with default FSTSMS sender ID
#           - DLT-registered sender_id + template recommended for real delivery
#
#   "otp" = Dedicated OTP template route
#           - REQUIRES: SMS_TEMPLATE_ID (registered OTP template on Fast2SMS dashboard)
#           - Sends only numeric `variables_values` via your template
#           - NO free-form `message` field
#           - May have higher deliverability for bank-grade OTP use cases
#
#   "dlt" = DLT-compliant transactional route (use with template_id + entity_id)
#   "t"   = Transactional route
#   "p"   = Promotional route (NOT for OTP)
SMS_ROUTE=q

# SMS Language: english / hindi / unicode
SMS_LANGUAGE=english

# SMS Flash: "0" = normal SMS (recommended), "1" = flash SMS
SMS_FLASH=0

# ============================================================
# DLT COMPLIANCE (RECOMMENDED FOR INDIAN SMS PER TRAI RULES)
# ============================================================
# Without these values, Fast2SMS API may accept the request BUT
# Indian operators (Jio/Vi/Airtel) can still BLOCK the SMS.
#
# 1. Register your entity on any DLT portal (Jio, Vodafone Idea, Airtel)
#    and get your Principal Entity ID (PE ID).
# 2. Register your Sender ID on the same DLT portal.
# 3. Create and APPROVE an SMS template that EXACTLY matches:
#      "Your verification OTP is {#VAR1#}. It is valid for 5 minutes."
# 4. Copy the Template ID and Entity ID below.
# ============================================================

# DLT Template ID (also called Template Registry ID)
# Get this from your DLT portal OR (for SMS_ROUTE=otp) from Fast2SMS Templates page.
# Required if SMS_ROUTE="otp". Optional (but recommended) for SMS_ROUTE="q"/"dlt".
SMS_TEMPLATE_ID=

# DLT Entity ID / PE ID / Principal Entity ID
# Get this from your DLT portal after entity registration.
SMS_ENTITY_ID=

# Alias for Entity ID (some docs call it PE ID). Leave blank if SMS_ENTITY_ID is set.
SMS_PE_ID=

# ============================================================
# OTHER
# ============================================================
OTP_TTL_SECONDS=300
FRONTEND_APP_URL=http://localhost:5173

